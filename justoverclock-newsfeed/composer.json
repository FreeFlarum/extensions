{
    "name": "justoverclock/flarum-ext-newsfeed",
    "description": "Add a Box that retrieve latest article from a RSS feed",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "source": "https://github.com/FreeFlarum/extensions/tree/main/justoverclock-newsfeed"
    },
    "require": {
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "flarum/testing": "^2.0.0"
    },
    "authors": [
        {
            "name": "Marco Colia",
            "email": "info@flarum.it",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Justoverclock\\NewsFeed\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "NewsFeed",
            "category": "",
            "icon": {
                "name": "fas fa-rss-square",
                "backgroundColor": "green",
                "color": "white"
            }
        },
        "flagrow": {
            "discuss": ""
        }
    }
}
