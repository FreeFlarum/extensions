{
    "name": "justoverclock/flarum-ext-guestengagement",
    "description": "Add a box that invite user to register under navbar",
    "keywords": [
        "guest engagement",
        "signup invite"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "source": "https://github.com/FreeFlarum/extensions/tree/main/justoverclock-guestengagement"
    },
    "require": {
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "flarum/testing": "^2.0.0"
    },
    "authors": [
        {
            "name": "Marco Colia",
            "email": "info@flarum.it",
            "role": "Developer",
            "homepage": "https://flarum.it"
        }
    ],
    "autoload": {
        "psr-4": {
            "Justoverclock\\Guestengagement\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Guestengagement",
            "category": "",
            "icon": {
                "name": "fas fa-sign-in-alt",
                "backgroundColor": "green",
                "color": "white"
            }
        },
        "flagrow": {
            "discuss": ""
        }
    }
}
